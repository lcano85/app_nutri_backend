generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model User {
  id               String   @id @default(uuid())
  email            String   @unique
  passwordHash     String
  firstName        String
  lastName         String
  roleId           String
  statusId         String
  refreshTokenHash String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  nutritionistPatients       Patient[]             @relation("NutritionistPatients")
  patientProfile             Patient?              @relation("PatientUser")
  appointmentsAsNutritionist Appointment[]         @relation("NutritionistAppointments")
  role                       Role                  @relation(fields: [roleId], references: [id])
  status                     Status                @relation(fields: [statusId], references: [id])
  loginLogs                  LoginLog[]
  recipes                    Recipe[]
  mealPlans                  MealPlan[]            @relation("NutritionistMealPlans")
  sentMessages               Message[]
  educationalResources       EducationalResource[]

  @@index([roleId])
  @@index([statusId])
  @@map("user")
}

model Status {
  id          String   @id @default(uuid())
  name        String   @unique
  code        String   @unique
  description String?
  color       String   @default("emerald")
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users User[]

  @@map("status")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  code        String   @unique
  description String?
  isSystem    Boolean  @default(false)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  permissions RolePermission[]

  @@map("role")
}

model Permission {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique
  module      String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles     RolePermission[]
  menuItems MenuItem[]

  @@index([module])
  @@map("permission")
}

model MenuItem {
  id           String   @id @default(uuid())
  name         String
  icon         String   @default("Circle")
  path         String?
  sortOrder    Int      @default(0)
  active       Boolean  @default(true)
  parentId     String?
  permissionId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  parent     MenuItem?   @relation("MenuHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children   MenuItem[]  @relation("MenuHierarchy")
  permission Permission? @relation(fields: [permissionId], references: [id], onDelete: SetNull)

  @@index([parentId])
  @@index([permissionId])
  @@map("menuitem")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("rolepermission")
}

model LoginLog {
  id        String   @id @default(uuid())
  userId    String?
  email     String
  success   Boolean
  ipAddress String?
  userAgent String?
  reason    String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId])
  @@map("loginlog")
}

model Patient {
  id                 String    @id @default(uuid())
  userId             String?   @unique
  nutritionistId     String
  documentNumber     String?
  phone              String?
  birthDate          DateTime?
  sex                String?
  heightCm           Decimal?  @db.Decimal(5, 2)
  allergies          Json
  conditions         Json
  dietaryPreferences Json
  acquisitionSource  String?
  sourceDetail       String?
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user         User?             @relation("PatientUser", fields: [userId], references: [id])
  nutritionist User              @relation("NutritionistPatients", fields: [nutritionistId], references: [id])
  measurements Measurement[]
  appointments Appointment[]
  mealPlans    MealPlan[]
  goals        Goal[]
  diaryEntries FoodDiaryEntry[]
  messages     Message[]
  payments     Payment[]
  documents    PatientDocument[]
  waterLogs    WaterLog[]
  activityLogs ActivityLog[]

  @@index([nutritionistId])
  @@map("patient")
}

model Measurement {
  id         String   @id @default(uuid())
  patientId  String
  measuredAt DateTime @default(now())
  weightKg   Decimal  @db.Decimal(5, 2)
  bodyFatPct Decimal? @db.Decimal(5, 2)
  waistCm    Decimal? @db.Decimal(5, 2)
  notes      String?

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId, measuredAt])
  @@map("measurement")
}

model Appointment {
  id               String            @id @default(uuid())
  patientId        String
  nutritionistId   String
  startsAt         DateTime
  endsAt           DateTime
  status           AppointmentStatus @default(SCHEDULED)
  reason           String?
  notes            String?
  consultationType String            @default("PRESENCIAL")
  meetingProvider  String?
  meetingUrl       String?
  reminderMinutes  Int               @default(1440)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  patient      Patient @relation(fields: [patientId], references: [id])
  nutritionist User    @relation("NutritionistAppointments", fields: [nutritionistId], references: [id])

  @@index([nutritionistId, startsAt])
  @@map("appointment")
}

model Food {
  id                String   @id @default(uuid())
  name              String
  category          String?
  servingName       String   @default("100 gramos")
  servingGrams      Decimal  @default(100) @db.Decimal(8, 2)
  calories          Decimal  @db.Decimal(8, 2)
  proteinGrams      Decimal  @default(0) @db.Decimal(8, 2)
  carbohydrateGrams Decimal  @default(0) @db.Decimal(8, 2)
  fatGrams          Decimal  @default(0) @db.Decimal(8, 2)
  fiberGrams        Decimal  @default(0) @db.Decimal(8, 2)
  sodiumMg          Decimal  @default(0) @db.Decimal(8, 2)
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  substitutionsFrom FoodSubstitution[] @relation("MainFood")
  substitutionsTo   FoodSubstitution[] @relation("SubstituteFood")

  @@index([name])
  @@index([category])
  @@map("food")
}

model tablaperuanaalimento {
  id                      String                @id @default(uuid())
  codigo                  String                @unique
  codigo_grupo            String
  codigo_numero           Int
  categoria_codigo        String
  nombre                  String
  grupo                   String?
  estrato                 String?
  energia_kcal            Decimal?              @db.Decimal(10, 2)
  energia_kj              Decimal?              @db.Decimal(10, 2)
  agua_g                  Decimal?              @db.Decimal(10, 2)
  proteina_g              Decimal?              @db.Decimal(10, 2)
  grasa_total_g           Decimal?              @db.Decimal(10, 2)
  carbohidratos_totales_g Decimal?              @db.Decimal(10, 2)
  carbohidratos_disp_g    Decimal?              @db.Decimal(10, 2)
  fibra_dietaria_g        Decimal?              @db.Decimal(10, 2)
  cenizas_g               Decimal?              @db.Decimal(10, 2)
  calcio_mg               Decimal?              @db.Decimal(10, 2)
  fosforo_mg              Decimal?              @db.Decimal(10, 2)
  zinc_mg                 Decimal?              @db.Decimal(10, 2)
  hierro_mg               Decimal?              @db.Decimal(10, 2)
  sodio_mg                Decimal?              @db.Decimal(10, 2)
  potasio_mg              Decimal?              @db.Decimal(10, 2)
  betacaroteno_ug         Decimal?              @db.Decimal(12, 2)
  vitamina_a_ug           Decimal?              @db.Decimal(12, 2)
  tiamina_mg              Decimal?              @db.Decimal(10, 2)
  riboflavina_mg          Decimal?              @db.Decimal(10, 2)
  niacina_mg              Decimal?              @db.Decimal(10, 2)
  vitamina_c_mg           Decimal?              @db.Decimal(10, 2)
  acido_folico_ug         Decimal?              @db.Decimal(10, 2)
  fuente                  String                @default("Tablas Peruanas de Composición de Alimentos, 11.ª edición digital, marzo de 2025")
  origen                  String                @default("ins_tpca_11_2023")
  estado                  Int                   @default(1) @db.TinyInt
  creado_en               DateTime              @default(now())
  actualizado_en          DateTime              @updatedAt
  categoria               tablaperuanacategoria @relation(fields: [categoria_codigo], references: [codigo])

  @@index([nombre])
  @@index([grupo])
  @@index([codigo_grupo, codigo_numero])
  @@index([categoria_codigo])
  @@index([estado])
  @@index([estado, grupo, nombre])
  @@map("tablaperuanaalimento")
}

model tablaperuanacategoria {
  codigo         String                 @id
  nombre         String
  estado         Int                    @default(1) @db.TinyInt
  creado_en      DateTime               @default(now())
  actualizado_en DateTime               @updatedAt
  alimentos      tablaperuanaalimento[]

  @@index([estado, nombre])
  @@map("tablaperuanacategoria")
}

model intercambiocategoria {
  id              Int                       @id
  codigo          String                    @unique
  nombre          String
  estado          Int                       @default(1) @db.TinyInt
  creado_en       DateTime                  @default(now())
  actualizado_en  DateTime                  @updatedAt
  subcategorias   intercambiosubcategoria[]
  alimentos       intercambioalimento[]

  @@index([estado, nombre])
  @@map("intercambiocategoria")
}

model intercambiosubcategoria {
  id               Int                    @id @default(autoincrement())
  categoria_id     Int
  codigo           String                 @unique
  nombre           String
  energia_kcal     Decimal                @db.Decimal(8, 2)
  proteina_g       Decimal                @db.Decimal(8, 2)
  lipidos_g        Decimal                @db.Decimal(8, 2)
  carbohidratos_g  Decimal                @db.Decimal(8, 2)
  estado           Int                    @default(1) @db.TinyInt
  creado_en        DateTime               @default(now())
  actualizado_en   DateTime               @updatedAt
  categoria        intercambiocategoria   @relation(fields: [categoria_id], references: [id])
  alimentos        intercambioalimento[]

  @@index([categoria_id, estado, nombre])
  @@map("intercambiosubcategoria")
}

model intercambioalimento {
  id                String                   @id @default(uuid())
  codigo            String                   @unique
  categoria_id      Int
  subcategoria_id   Int
  nombre            String
  peso_gramos       Decimal                  @db.Decimal(8, 2)
  medida_casera     String
  fuente            String                   @default("Guía de intercambio de alimentos — INS/CENAN/MINSA, primera edición, noviembre de 2014")
  estado            Int                      @default(1) @db.TinyInt
  creado_en         DateTime                 @default(now())
  actualizado_en    DateTime                 @updatedAt
  categoria         intercambiocategoria     @relation(fields: [categoria_id], references: [id])
  subcategoria      intercambiosubcategoria  @relation(fields: [subcategoria_id], references: [id])

  @@index([nombre])
  @@index([categoria_id, subcategoria_id, estado])
  @@index([estado, nombre])
  @@map("intercambioalimento")
}

model dosificacioncategoria {
  id             Int                    @id
  codigo         String                 @unique
  nombre         String
  estado         Int                    @default(1) @db.TinyInt
  creado_en      DateTime               @default(now())
  actualizado_en DateTime               @updatedAt
  alimentos      dosificacionalimento[]

  @@index([estado, nombre])
  @@map("dosificacioncategoria")
}

model dosificacionalimento {
  id             String                  @id @default(uuid())
  codigo         String                  @unique
  orden          Int                     @unique
  categoria_id   Int
  nombre         String
  estado         Int                     @default(1) @db.TinyInt
  creado_en      DateTime                @default(now())
  actualizado_en DateTime                @updatedAt
  categoria      dosificacioncategoria   @relation(fields: [categoria_id], references: [id])
  dosificaciones dosificacionpreparacion[]

  @@index([categoria_id, estado, nombre])
  @@index([nombre])
  @@map("dosificacionalimento")
}

model dosificacionpreparacion {
  id                     String                @id @default(uuid())
  alimento_id            String
  preparacion            String
  peso_bruto_kg          Decimal               @db.Decimal(10, 2)
  peso_neto_kg           Decimal               @db.Decimal(10, 2)
  energia_kcal           Decimal?              @db.Decimal(10, 2)
  proteina_g             Decimal?              @db.Decimal(10, 2)
  grasa_g                Decimal?              @db.Decimal(10, 2)
  carbohidrato_g         Decimal?              @db.Decimal(10, 2)
  hierro_mg              Decimal?              @db.Decimal(10, 2)
  retinol_ug             Decimal?              @db.Decimal(12, 2)
  porcion_comestible_pct Decimal?              @db.Decimal(6, 2)
  fuente                 String                @default("Tabla de dosificación de alimentos para servicios de alimentación colectiva — MINSA/INS/CENAN, 2005")
  estado                 Int                   @default(1) @db.TinyInt
  creado_en              DateTime              @default(now())
  actualizado_en         DateTime              @updatedAt
  alimento               dosificacionalimento  @relation(fields: [alimento_id], references: [id])

  @@index([alimento_id, estado])
  @@index([preparacion])
  @@index([estado, alimento_id])
  @@map("dosificacionpreparacion")
}

model FoodSubstitution {
  id                      String  @id @default(uuid())
  foodId                  String
  substituteFoodId        String
  equivalentType          String  @default("ENERGIA")
  foodQuantityGrams       Decimal @db.Decimal(8, 2)
  substituteQuantityGrams Decimal @db.Decimal(8, 2)
  notes                   String?

  food           Food @relation("MainFood", fields: [foodId], references: [id], onDelete: Cascade)
  substituteFood Food @relation("SubstituteFood", fields: [substituteFoodId], references: [id], onDelete: Cascade)

  @@unique([foodId, substituteFoodId])
  @@map("foodsubstitution")
}

model Message {
  id        String    @id @default(uuid())
  patientId String
  senderId  String
  content   String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  sender  User    @relation(fields: [senderId], references: [id])

  @@index([patientId, createdAt])
  @@map("message")
}

model Payment {
  id        String    @id @default(uuid())
  patientId String
  concept   String
  amount    Decimal   @db.Decimal(10, 2)
  currency  String    @default("PEN")
  status    String    @default("PENDIENTE")
  method    String?
  dueDate   DateTime?
  paidAt    DateTime?
  reference String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  @@index([patientId])
  @@map("payment")
}

model EducationalResource {
  id             String   @id @default(uuid())
  nutritionistId String
  title          String
  category       String?
  type           String   @default("ARTICULO")
  content        String?
  url            String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  nutritionist User @relation(fields: [nutritionistId], references: [id])

  @@index([nutritionistId])
  @@map("educationalresource")
}

model PatientDocument {
  id        String   @id @default(uuid())
  patientId String
  name      String
  category  String?
  url       String
  notes     String?
  createdAt DateTime @default(now())

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("patientdocument")
}

model WaterLog {
  id         String   @id @default(uuid())
  patientId  String
  occurredAt DateTime
  amountMl   Int

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId, occurredAt])
  @@map("waterlog")
}

model ActivityLog {
  id              String   @id @default(uuid())
  patientId       String
  occurredAt      DateTime
  activity        String
  durationMinutes Int
  caloriesBurned  Int?
  notes           String?

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId, occurredAt])
  @@map("activitylog")
}

model Recipe {
  id                 String   @id @default(uuid())
  nutritionistId     String
  name               String
  description        String?
  ingredients        Json
  instructions       String
  servings           Int      @default(1)
  preparationMinutes Int?
  calories           Decimal? @db.Decimal(8, 2)
  proteinGrams       Decimal? @db.Decimal(8, 2)
  carbohydrateGrams  Decimal? @db.Decimal(8, 2)
  fatGrams           Decimal? @db.Decimal(8, 2)
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  nutritionist User @relation(fields: [nutritionistId], references: [id])

  @@index([nutritionistId])
  @@map("recipe")
}

model MealPlan {
  id                      String    @id @default(uuid())
  patientId               String
  nutritionistId          String
  name                    String
  description             String?
  startsAt                DateTime
  endsAt                  DateTime?
  status                  String    @default("BORRADOR")
  targetCalories          Int?
  targetProteinGrams      Decimal?  @db.Decimal(8, 2)
  targetCarbohydrateGrams Decimal?  @db.Decimal(8, 2)
  targetFatGrams          Decimal?  @db.Decimal(8, 2)
  meals                   Json
  recommendations         String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  patient      Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  nutritionist User    @relation("NutritionistMealPlans", fields: [nutritionistId], references: [id])

  @@index([patientId])
  @@index([nutritionistId])
  @@map("mealplan")
}

model Goal {
  id           String    @id @default(uuid())
  patientId    String
  title        String
  description  String?
  targetValue  Decimal?  @db.Decimal(10, 2)
  currentValue Decimal?  @db.Decimal(10, 2)
  unit         String?
  status       String    @default("EN_PROGRESO")
  dueDate      DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@map("goal")
}

model FoodDiaryEntry {
  id          String   @id @default(uuid())
  patientId   String
  occurredAt  DateTime
  mealType    String
  description String
  calories    Int?
  waterMl     Int?
  mood        String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId, occurredAt])
  @@map("fooddiaryentry")
}
